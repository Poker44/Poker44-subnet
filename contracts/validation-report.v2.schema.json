{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poker44.net/contracts/validation-report.v2.schema.json",
  "title": "Poker44 Validation Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "round_id",
    "sequence",
    "event_type",
    "netuid",
    "validator_hotkey",
    "created_at",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "round_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0 },
    "netuid": { "type": "integer", "minimum": 0 },
    "event_type": {
      "enum": [
        "validation_round_started",
        "sessions_acquired",
        "miners_queried",
        "rewards_computed",
        "weights_computed",
        "weights_submitted",
        "weights_finalized",
        "validation_round_failed"
      ]
    },
    "validator_hotkey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "validator_uid": { "type": ["integer", "null"], "minimum": 0 },
    "validator_name": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
