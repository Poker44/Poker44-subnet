{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poker44.net/contracts/subject-session.v2.schema.json",
  "title": "Poker44 Subject Session v2",
  "description": "Miner-visible tournament session with pseudonymous identifiers, relative action timing and sanitized interaction telemetry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "window_id", "hands", "telemetry"],
  "properties": {
    "schema_version": { "const": "2" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "window_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "hands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hand_number", "actions"],
        "properties": {
          "hand_number": { "type": "integer", "minimum": 1 },
          "actions": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sequence", "event_type", "action_type"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 0 },
                "event_type": { "type": "string", "minLength": 1, "maxLength": 64 },
                "action_type": {
                  "type": "string",
                  "enum": ["fold", "check", "call", "bet", "raise", "all_in"]
                },
                "phase": { "type": ["string", "null"], "maxLength": 32 },
                "amount": { "type": ["integer", "null"] },
                "call_amount": { "type": ["integer", "null"] },
                "raise_to": { "type": ["integer", "null"] },
                "is_all_in": { "type": "boolean" },
                "pot_size": { "type": "integer", "minimum": 0 },
                "current_bet": { "type": "integer", "minimum": 0 },
                "player_stack": { "type": ["integer", "null"], "minimum": 0 },
                "active_players": { "type": "integer", "minimum": 0 },
                "seat_position": { "type": ["integer", "null"], "minimum": 0 },
                "position_name": { "type": ["string", "null"], "maxLength": 32 },
                "community_cards": {
                  "type": ["array", "null"],
                  "items": { "type": "string", "maxLength": 3 },
                  "maxItems": 5
                },
                "hole_cards": {
                  "type": ["array", "null"],
                  "items": { "type": "string", "maxLength": 3 },
                  "maxItems": 2
                },
                "decision_time_ms": { "type": ["integer", "null"], "minimum": 0 },
                "time_since_last_action_ms": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "session_offset_ms": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "summary"],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "offset_ms",
              "event_type",
              "target_category",
              "value"
            ],
            "properties": {
              "sequence": { "type": "integer", "minimum": 0 },
              "offset_ms": { "type": "integer", "minimum": 0 },
              "event_type": {
                "type": "string",
                "enum": [
                  "click",
                  "pointer_down",
                  "pointer_move",
                  "scroll",
                  "focus_in",
                  "visibility"
                ]
              },
              "target_category": {
                "type": ["string", "null"],
                "enum": ["poker_action", "navigation", "control", "other", null]
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "button": {
                    "type": ["string", "number", "boolean", "null"]
                  },
                  "pointer": {
                    "type": ["string", "number", "boolean", "null"]
                  },
                  "x_bucket": {
                    "type": ["string", "number", "boolean", "null"]
                  },
                  "y_bucket": {
                    "type": ["string", "number", "boolean", "null"]
                  },
                  "visible": {
                    "type": ["string", "number", "boolean", "null"]
                  }
                }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_count",
            "action_count",
            "duration_ms",
            "decision_count",
            "decision_mean_ms",
            "decision_std_ms"
          ],
          "properties": {
            "event_count": { "type": "integer", "minimum": 0 },
            "action_count": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "decision_count": { "type": "integer", "minimum": 0 },
            "decision_mean_ms": { "type": "number", "minimum": 0 },
            "decision_std_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
